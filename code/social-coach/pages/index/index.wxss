.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #f5f5f5 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.hero {
  text-align: center;
  margin-bottom: 80rpx;
}

.hero-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

.split-area {
  width: 680rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.split-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  transition: transform 0.2s;
}

.split-card:active {
  transform: scale(0.98);
}

.split-card.urgent {
  border-left: 8rpx solid #e94560;
}

.split-card.prepare {
  border-left: 8rpx solid #0f3460;
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.card-arrow {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

.hint {
  margin-top: 48rpx;
  padding: 20rpx 40rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 40rpx;
}

.hint text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
