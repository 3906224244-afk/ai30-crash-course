/* ===== 首页 — 简笔画Hero + 手绘便签 ===== */

.page-scroll {
  height: 100vh;
  background: var(--bg-primary);
}

.container {
  background: var(--bg-primary);
}

/* ================================================================
   Hero — 简笔画场景插画
   ================================================================ */

.hero-wrap {
  position: relative;
  width: 100vw;
  height: 60vh;
  background: var(--bg-primary);
}

.hero-swiper {
  width: 100vw;
  height: 60vh;
}

.hero-slide {
  width: 100vw;
  height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-primary);
}

/* 插画 — aspectFit + 微浮动 */
.hero-illust {
  width: 80%;
  height: 65%;
  margin-top: 20rpx;
  pointer-events: none;
  animation: float 3.5s ease-in-out infinite;
}

/* 翻页缩放 */
.illust-pop {
  animation: float 3.5s ease-in-out infinite, popIn 0.5s ease-out;
}

/* 底部文字 */
.hero-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 48rpx 56rpx;
}

.hero-tagline {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  line-height: 1.3;
  text-align: center;
  opacity: 0;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  text-align: center;
  opacity: 0;
}

/* 文字逐行滑入 */
.text-slide-in {
  animation: slideUp 0.4s ease-out forwards;
}

/* ===== 关键帧 ===== */

/* 微浮动 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 翻页缩放弹入 */
@keyframes popIn {
  0% { transform: scale(0.94); opacity: 0.5; }
  60% { transform: scale(1.03); }
  100% { transform: scale(1); opacity: 1; }
}

/* 文字上滑淡入 */
@keyframes slideUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 自定义指示器 — 画线效果 */
.hero-dots {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
  padding-bottom: 16rpx;
  z-index: 3;
}

.hdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.hdot-active {
  width: 36rpx;
  border-radius: 5rpx;
  background: #2D2D2D;
  animation: drawLine 0.35s ease-out;
}

@keyframes drawLine {
  from { width: 10rpx; border-radius: 50%; }
  to { width: 36rpx; border-radius: 5rpx; }
}

/* ================================================================
   按钮区
   ================================================================ */

.action-area {
  padding: 32rpx 40rpx;
  display: flex;
  gap: 24rpx;
}

.action-area .btn-primary,
.action-area .btn-secondary {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
}

/* 开始咨询单独加黑框 */
.action-area .btn-primary {
  box-shadow: 4px 4px 0 #2D2D2D;
  transform: translate(0, 0) rotate(-0.3deg);
}
.action-area .btn-primary:active {
  transform: translate(4px, 4px) rotate(-0.3deg);
  box-shadow: 0 0 0 #2D2D2D;
}

/* ================================================================
   知识卡便签轮播
   ================================================================ */

.knowledge-section {
  padding: 0 0 24rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 40rpx 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.card-swiper {
  height: 320rpx;
}

/* 便签卡片 */
.sticky-card {
  height: 290rpx;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 20rpx 30rpx 14rpx 26rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 3px 3px 0 #2D2D2D;
  transform: rotate(-0.35deg);
  position: relative;
  overflow: visible;
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.sticky-card:active {
  transform: rotate(-0.35deg) translate(3px, 3px);
  box-shadow: 0 0 0 #2D2D2D;
}

/* 胶带装饰 */
.card-tape {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(2deg);
  width: 64rpx;
  height: 24rpx;
  opacity: 0.5;
  pointer-events: none;
}

/* 简笔画图标 */
.card-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
}

.card-tag {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-brief {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-more {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: auto;
}

/* 指示器 */
.swiper-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  padding-top: 20rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--border);
  transition: all 0.15s ease;
}

.dot-active {
  width: 28rpx;
  border-radius: 4rpx;
  background: var(--text-primary);
}

/* ===== 底部留白 ===== */
.page-bottom {
  height: 80rpx;
}
