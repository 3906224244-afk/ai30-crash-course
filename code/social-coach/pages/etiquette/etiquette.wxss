.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.page-header {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.page-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 6rpx;
}

.page-sub {
  font-size: 24rpx;
  color: #999;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 分类 */
.categories {
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding: 4rpx 0;
}

.cat-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #fff;
  color: #666;
  transition: all 0.2s;
}

.cat-tag.active {
  background: #e94560;
  color: #fff;
}

/* 条目 */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  transition: transform 0.2s;
}

.entry-card:active {
  transform: scale(0.98);
}

.entry-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.entry-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
  margin-bottom: 4rpx;
}

.entry-brief {
  font-size: 24rpx;
  color: #999;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-left: 56rpx;
}

.e-tag {
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}

.detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
  width: 100%;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 20rpx;
}

.detail-divider {
  height: 2rpx;
  background: #f0f0f0;
  margin-bottom: 24rpx;
}

.detail-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.detail-source {
  margin-bottom: 32rpx;
}

.detail-source text {
  font-size: 24rpx;
  color: #bbb;
}

.detail-close {
  width: 100%;
}
