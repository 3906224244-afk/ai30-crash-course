/* ================================================================
   知识库 — 奶油纸底 + 手绘卡片
   ================================================================ */

.page-scroll {
  height: 100vh;
  background: var(--bg-primary);
}

.container {
  background: var(--bg-primary);
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
}

/* ---- 搜索栏：手绘边框 ---- */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 28rpx 36rpx 22rpx 32rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 3px 3px 0 #2D2D2D;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

/* ---- 分类 chips：手绘胶囊 ---- */
.categories {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 26rpx 34rpx 22rpx 30rpx;
  font-size: 26rpx;
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1.5px solid var(--border);
  transition: all 0.12s ease;
}

.cat-chip text {
  color: var(--text-secondary);
}

.cat-on {
  background: var(--accent-warm);
  border-color: #2D2D2D;
  box-shadow: var(--shadow-hard-sm);
}

.cat-on text {
  color: var(--text-primary);
  font-weight: 600;
}

/* ================================================================
   卡片网格 — 2列手绘便签
   ================================================================ */

.card-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.know-card {
  width: 100%;
  min-height: 160rpx;
  flex-direction: row;
  align-items: center;
  border-radius: 18rpx 28rpx 14rpx 24rpx;
  border-radius: var(--radius-lg);
  border: 1.5px solid #2D2D2D;
  background: var(--bg-card);
  box-shadow: var(--shadow-hard-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx;
  box-sizing: border-box;
  transform: rotate(-0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
  position: relative;
}

.know-card:nth-child(even) {
  transform: rotate(0.4deg);
  border-radius: 24rpx 14rpx 28rpx 16rpx;
}

.know-card:nth-child(3n) {
  transform: rotate(-0.25deg);
  border-radius: 16rpx 26rpx 20rpx 30rpx;
}

.know-card:active {
  transform: scale(0.97);
  box-shadow: 0 0 0 #2D2D2D;
}

/* 简笔画图标 */
.card-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  margin-bottom: 0;
  flex-shrink: 0;
}

/* 内容 */
.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
  display: block;
  margin-bottom: 6rpx;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-brief {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 0;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.c-tag {
  font-size: 18rpx;
  color: var(--text-secondary);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--bg-card-muted);
  border: 1px solid var(--border-light);
}

/* ---- 空态 ---- */
.empty {
  text-align: center;
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ---- 底部留白 ---- */
.page-bottom {
  height: 48rpx;
}

/* ================================================================
   详情弹窗 — 手绘便签底部弹出
   ================================================================ */

.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.detail-card {
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 32rpx 40rpx 0 0;
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  transform: rotate(-0.2deg);
}

/* 胶带装饰 */
.detail-tape {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%) rotate(3deg);
  width: 80rpx;
  height: 30rpx;
  opacity: 0.4;
  z-index: 2;
  pointer-events: none;
}

.detail-body {
  padding: 40rpx 32rpx 48rpx;
  overflow-y: auto;
}

.detail-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
  margin-bottom: 12rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.d-tag {
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: var(--bg-card-muted);
  border: 1px solid var(--border);
}

.detail-divider {
  height: 1px;
  background: var(--border);
  margin-bottom: 24rpx;
}

.detail-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.85;
  display: block;
  margin-bottom: 28rpx;
  white-space: pre-line;
}

/* 使用提示 */
.detail-tips {
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid var(--accent);
  background: var(--accent-ghost);
  margin-bottom: 20rpx;
}

.tips-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  display: block;
  margin-bottom: 12rpx;
}

.tip-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.tip-bullet {
  font-size: 24rpx;
  color: var(--accent);
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  flex: 1;
}

.detail-source {
  margin-bottom: 28rpx;
}

.detail-source text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.detail-close-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: transparent;
  border: none;
  box-shadow: none;
  transform: rotate(-0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.detail-close-btn:active {
  transform: translate(4px, 4px) rotate(-0.3deg);
  box-shadow: none;
}

.detail-close-btn text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}
