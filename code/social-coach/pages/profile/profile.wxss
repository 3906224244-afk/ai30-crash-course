.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.step-header {
  text-align: center;
  padding: 60rpx 0 32rpx;
}

.step-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.step-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 8rpx;
}

.step-sub {
  font-size: 26rpx;
  color: #999;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e94560, #c23152);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 问题卡片 */
.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.q-label {
  font-size: 24rpx;
  color: #e94560;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.q-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
  margin-bottom: 36rpx;
  display: block;
}

.q-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.q-option {
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  transition: all 0.2s;
}

.q-option:active {
  background: #fef2f2;
  border-color: #e94560;
}

.q-option.selected {
  background: #fef2f2;
  border-color: #e94560;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #666;
  flex-shrink: 0;
}

.q-option.selected .option-label {
  background: #e94560;
  color: #fff;
}

.option-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

/* 自定义输入 */
.q-custom {
  margin-top: 16rpx;
}

.custom-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.custom-input {
  width: 100%;
  min-height: 160rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
}

.custom-input:focus {
  border-color: #e94560;
  background: #fff;
}

/* 方向提示表格 */
.direction-table {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 2rpx dashed #e0e0e0;
}

.direction-title {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.direction-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.direction-item {
  background: #fff;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #888;
  border: 1rpx solid #e8e8e8;
}

/* 最后一题自由输入区 */
.q-free-area {
  margin-top: 8rpx;
}

.free-input {
  width: 100%;
  min-height: 200rpx;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx dashed #e0e0e0;
  transition: border-color 0.3s;
}

.free-input:focus {
  border-color: #e94560;
  border-style: solid;
  background: #fff;
}

/* 操作 */
.q-actions {
  display: flex;
  gap: 24rpx;
}

.q-actions > view {
  flex: 1;
}

.skip-link {
  text-align: center;
  margin-top: 32rpx;
}

.skip-link text {
  font-size: 26rpx;
  color: #bbb;
  padding: 12rpx 32rpx;
}
