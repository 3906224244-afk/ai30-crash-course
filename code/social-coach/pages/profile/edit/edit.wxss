/* ===== 编辑人设 ===== */

.container {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 24rpx;
}

.step-header {
  text-align: center;
  padding: 48rpx 0 36rpx;
}

.step-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 14rpx;
}

.step-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.step-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: var(--border-light);
  border-radius: 4rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.question-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 50, 43, 0.06);
}

.q-label {
  font-size: 24rpx;
  color: var(--accent);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.q-text {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

.q-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.q-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFF9F5;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.q-option:active,
.q-option.selected {
  background: #FDF3EB;
  border-color: var(--accent);
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--border-light);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.q-option.selected .option-label {
  background: var(--accent);
  color: #FFF;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.q-custom {
  margin-bottom: 24rpx;
}

.custom-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.custom-input {
  width: 100%;
  min-height: 120rpx;
  background: #FFF9F5;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid var(--border-light);
}

.direction-table {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #FEF5EC;
  border-radius: 20rpx;
  border: 2rpx dashed var(--border);
}

.direction-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.direction-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.direction-item {
  background: #FFF;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--border-light);
}

.direction-item text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.q-free-area {
  margin-bottom: 24rpx;
}

.free-input {
  width: 100%;
  min-height: 160rpx;
  background: #FFF9F5;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx dashed var(--border);
}

.q-actions {
  display: flex;
  gap: 20rpx;
}

.q-actions .btn-secondary {
  flex: 1;
}

.q-actions .btn-primary {
  flex: 2;
}

.skip-link {
  text-align: center;
  margin-top: 28rpx;
}

.skip-link text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}
