/* ===== 咨询页 — 手绘便签对话流 ===== */

.container {
  min-height: 100vh;
  background: var(--bg-primary);
}

.step {
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========================================
   Step 0 — 入口
   ======================================== */

.entry {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 100rpx 48rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.entry-illust {
  width: 360rpx;
  height: 320rpx;
  margin-bottom: 40rpx;
  pointer-events: none;
}

.entry-heading {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.25;
  letter-spacing: -1rpx;
  display: block;
  margin-bottom: 24rpx;
}

.entry-heading-accent {
  color: var(--accent);
}

.entry-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 560rpx;
  display: block;
  margin-bottom: 64rpx;
}

.entry-btn-full {
  width: 440rpx;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 32rpx 20rpx 34rpx 18rpx;
  box-shadow: none;
  transform: rotate(-0.4deg);
}
.entry-btn-full:active {
  transform: translate(4px, 4px) rotate(-0.4deg);
  box-shadow: none;
}

.entry-profile {
  margin-top: 32rpx;
}

.entry-profile text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  border-bottom: 1.5px dashed var(--border);
}

/* 底部装饰涂鸦 */
.entry-deco {
  margin-top: auto;
  margin-bottom: 80rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  pointer-events: none;
}

.deco-scribble {
  width: 92%;
  height: 120rpx;
}

.deco-star {
  width: 88%;
  height: 100rpx;
}

/* ========================================
   Step 1 — 对话流
   ======================================== */

/* ---- 等待态 ---- */
.chat-waiting {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.waiting-dot-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.w-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-primary);
  opacity: 0.2;
  animation: dotPulse 0.8s ease-in-out infinite alternate;
}

.w-dot:nth-child(2) { animation-delay: 0.2s; }
.w-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  from { opacity: 0.2; transform: scale(0.8); }
  to { opacity: 0.8; transform: scale(1.2); }
}

.waiting-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ---- 自由叙述 ---- */
.chat-free {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 40rpx 48rpx;
}

.chat-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.cp-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.cp-bar {
  flex: 1;
  height: 3rpx;
  background: var(--border);
  border-radius: 2rpx;
}

.cp-fill {
  height: 100%;
  background: var(--text-primary);
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.chat-prompt {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  display: block;
  margin-bottom: 32rpx;
}

/* 场景chips */
.scene-row {
  margin-bottom: 28rpx;
}

.scene-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 12rpx;
}

.scene-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.scene-chip {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 24rpx;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-xl);
  transition: all var(--transition);
}

.scene-chip:active {
  background: var(--bg-card-muted);
}

.chip-on {
  background: var(--accent-warm);
  color: var(--text-primary);
  border-color: #2D2D2D;
  box-shadow: var(--shadow-hard-sm);
}

/* 输入区 — 手绘边框 */
.chat-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  box-sizing: border-box;
  flex: 1;
  border: 1.5px dashed var(--border);
  border-radius: 16rpx 24rpx 12rpx 22rpx;
  background: var(--bg-card);
}

/* 提交按钮 */
.chat-submit {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: transparent;
  border: none;
  box-shadow: none;
  margin-top: auto;
  transform: translate(0, 0) rotate(-0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.chat-submit text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.chat-submit:active {
  transform: translate(4px, 4px) rotate(-0.3deg);
  box-shadow: none;
}

.submit-off {
  background-image: url('/images/btn-secondary-bg.png');
  opacity: 0.5;
  box-shadow: none;
  pointer-events: none;
}

.submit-off text {
  color: var(--text-tertiary);
}

.submit-off:active {
  transform: none;
  box-shadow: none;
}

/* 返回 */
.chat-back {
  text-align: center;
  padding-top: 20rpx;
}

.chat-back text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  border-bottom: 1.5px dashed var(--border);
}

/* ========================================
   Step 2 — 生成等待
   ======================================== */

.gen-waiting {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.gen-illust {
  width: 300rpx;
  height: 260rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.gen-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.gen-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 48rpx;
  text-align: center;
  line-height: 1.6;
}

.gen-bar {
  width: 200rpx;
  height: 4rpx;
  background: var(--border);
  border-radius: 2rpx;
  overflow: hidden;
}

.gen-bar-fill {
  width: 30%;
  height: 100%;
  background: var(--text-primary);
  border-radius: 2rpx;
  animation: barSlide 1.2s ease-in-out infinite;
}

@keyframes barSlide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(440%); }
}

/* ========================================
   Step 3 — 结果
   ======================================== */

.reset-row {
  padding: 40rpx 32rpx;
}

.reset-btn-full {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
}
