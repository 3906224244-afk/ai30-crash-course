<!-- 咨询页：场景描述 → 追问 → 5条策略 -->
<view class="container">

  <!-- Step 0: 场景输入 -->
  <view class="step" wx:if="{{step === 0}}">
    <view class="step-header">
      <text class="step-icon">💬</text>
      <text class="step-title">说说你的情况</text>
      <text class="step-sub">描述越具体，建议越精准</text>
    </view>
    <textarea
      class="situation-input"
      placeholder="比如：导师让我这周改完论文但来不及了，怎么回复他..."
      value="{{situation}}"
      bindinput="onSituationInput"
      auto-height
      maxlength="-1"
    />
    <view class="quick-examples">
      <text class="example-label">💡 可以这么说：</text>
      <view class="example-tags">
        <text class="tag" bindtap="fillExample" data-text="导师催论文怎么回">导师催论文怎么回</text>
        <text class="tag" bindtap="fillExample" data-text="同事让我帮忙，不想答应">同事让我帮忙，不想答应</text>
        <text class="tag" bindtap="fillExample" data-text="相亲对象约我，不想去">相亲对象约我，不想去</text>
        <text class="tag" bindtap="fillExample" data-text="朋友借钱怎么拒绝">朋友借钱怎么拒绝</text>
        <text class="tag" bindtap="fillExample" data-text="领导请客怎么敬酒">领导请客怎么敬酒</text>
      </view>
    </view>
    <button class="btn-primary" bindtap="submitSituation">
      开始分析 →
    </button>
  </view>

  <!-- Step 1: 追问轮 → 使用 question-card 原子组件 -->
  <view class="step" wx:if="{{step === 1}}">
    <question-card
      questionType="{{questions[currentQIndex].type}}"
      questionIndex="{{currentQIndex + 1}}"
      totalQuestions="{{questions.length}}"
      text="{{questions[currentQIndex].text}}"
      options="{{questions[currentQIndex].options}}"
      directionHints="{{directionHints}}"
      isLast="{{isLastQuestion}}"
      bind:submit="onQuestionSubmit"
      bind:skip="onQuestionSkip"
    />
  </view>

  <!-- Step 2: 分析中 -->
  <view class="step" wx:if="{{step === 2}}">
    <view class="loading-area">
      <text class="loading-icon">🧠</text>
      <text class="loading-text">正在分析你的情况...</text>
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>

  <!-- Step 3: 5条策略结果 → 使用 strategy-list-card 原子组件 -->
  <view class="step" wx:if="{{step === 3}}">
    <strategy-list-card
      contextLabel="{{contextLabel}}"
      guideTitle="怎么选？先看这张表"
      guideIntro="下面5条不是同一种意思的5种说法，而是5条完全不同的路。每条路走下去，对方的反应和后续走向都不一样。"
      guideQuickRef="{{guideQuickRef}}"
      guideTip="💡 不确定选哪个？先看每条的风险提示，排除你不能承担的。"
      strategies="{{strategies}}"
      bind:copy="onStrategyCopy"
    />
    <button class="btn-secondary reset-btn" bindtap="resetAdvice">🔄 换一个场景咨询</button>
  </view>

</view>
