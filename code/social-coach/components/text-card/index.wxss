/* ===== text-card — 手绘纸条 ===== */

.card-container {
  position: relative;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 18rpx 28rpx 14rpx 24rpx;
  margin: 0 16px;
  padding: 28rpx 24rpx;
  overflow: hidden;
  box-shadow: 3px 3px 0 #2D2D2D;
  transform: rotate(-0.3deg);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.card-body {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 32rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}
