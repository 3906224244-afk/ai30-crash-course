/* ========== text-card 原子组件样式 ========== */

.card-container {
  position: relative;
  background: #fff;
  border-radius: 4px;
  margin: 0 16px;
  padding: 20px 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.card-title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12px;
  line-height: 1.5;
}

.card-body {
  font-size: 15px;
  color: #555;
  line-height: 1.8;
}

/* 底部渐变遮罩：指示内容可能被截断 */
.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 32px;
  background: linear-gradient(transparent, #fff);
  pointer-events: none;
}

/* ========== 暗黑模式 ========== */
@media (prefers-color-scheme: dark) {
  .card-container {
    background: #2a2a2e;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .card-title {
    color: #e0e0e0;
  }

  .card-body {
    color: #b0b0b0;
  }

  .bottom-fade {
    background: linear-gradient(transparent, #2a2a2e);
  }
}
