/* ===== question-card — 手绘便签式 ===== */

.card-container {
  position: relative;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 22rpx 30rpx 16rpx 28rpx;
  margin: 0 16px;
  padding: 28rpx 24rpx;
  overflow: hidden;
  box-shadow: 3px 3px 0 #2D2D2D;
  transform: rotate(-0.35deg);
}

/* ===== 进度条 ===== */
.progress-area {
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 22rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
  display: block;
}

.progress-bar {
  height: 6rpx;
  background: var(--border);
  border-radius: 3rpx;
  overflow: hidden;
  border: 1px solid var(--border);
}

.progress-fill {
  height: 100%;
  background: var(--accent-warm);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* ===== 问题正文 ===== */
.question-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ===== choice 型选项 ===== */
.q-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.q-option {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  transition: border-color var(--transition), box-shadow var(--transition);
}

.q-option.selected {
  border-color: #2D2D2D;
  box-shadow: var(--shadow-hard-sm);
  background: var(--accent-ghost);
}

.option-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: var(--bg-card);
}

.option-badge text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.badge-selected {
  background: var(--accent-warm);
  border-color: #2D2D2D;
}

.badge-selected text {
  color: var(--text-primary);
}

.option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  flex: 1;
}

/* ===== D 选项自定义输入框 ===== */
.custom-input {
  width: 100%;
  min-height: 120rpx;
  max-height: 300rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  box-sizing: border-box;
  border: 1.5px dashed var(--border);
  border-radius: 16rpx 24rpx 12rpx 22rpx;
  background: var(--bg-card);
  margin-bottom: 16rpx;
}

/* ===== 语音引导区 ===== */
.voice-guide {
  margin-bottom: 16rpx;
  padding: 20rpx 16rpx;
  background: var(--bg-card-muted);
  border: 1.5px dashed var(--border);
  border-radius: var(--radius-md);
  text-align: center;
}

.voice-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  margin: 0 auto 8rpx;
  opacity: 0.5;
}

.voice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.voice-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.voice-guide-free {
  background: var(--accent-ghost);
  border-color: var(--accent-warm);
}

/* ===== free 型方向提示 ===== */
.direction-hints {
  margin-bottom: 16rpx;
}

.hints-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.hints-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hint-chip {
  padding: 8rpx 16rpx;
  border: 1.5px dashed var(--border);
  border-radius: var(--radius-xl);
  background: var(--bg-card-muted);
}

.hint-chip text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 操作按钮 ===== */
.action-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

/* btn-bg-img — 组件内独立，全局样式被隔离 */
.btn-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 10rpx 28rpx;
  background: transparent;
  border: none;
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: none;
  transform: translate(0, 0) rotate(-0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.btn-outline text {
  position: relative;
  z-index: 1;
  color: #2D2D2D;
}

.btn-outline:active {
  transform: translate(3px, 3px) rotate(-0.3deg);
  box-shadow: none;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: transparent;
  color: var(--text-primary);
  border: none;
  box-shadow: none;
  transform: translate(0, 0) rotate(-0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.btn-primary text {
  position: relative;
  z-index: 1;
  color: #2D2D2D;
}

.btn-submit {
  padding: 16rpx 44rpx;
  font-size: 28rpx;
}

.btn-submit.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}
