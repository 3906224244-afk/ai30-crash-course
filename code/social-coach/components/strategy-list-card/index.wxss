/* ===== strategy-list-card — 手绘便签式 ===== */

.card-container {
  position: relative;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 20rpx 30rpx 14rpx 28rpx;
  margin: 0 16px;
  padding: 32rpx;
  overflow: hidden;
  box-shadow: 4px 4px 0 #2D2D2D;
  transform: rotate(-0.3deg);
}

/* ===== 引导区 ===== */
.guide-section {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1.5px dashed var(--border);
}

.guide-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.context-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-ghost);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  border: 1px solid var(--accent-warm);
  font-weight: 500;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.guide-intro {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: block;
  margin-bottom: 16rpx;
}

/* 快速参考表 */
.quick-ref {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-bottom: 12rpx;
}

.ref-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  gap: 12rpx;
}

.ref-badge {
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  border: 1px solid var(--border);
  background: var(--bg-card-muted);
  flex-shrink: 0;
}

.ref-badge text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.ref-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.guide-tip {
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--accent);
  background: var(--accent-ghost);
  border-radius: 0 8rpx 8rpx 0;
}

.guide-tip text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 策略列表 ===== */
.strategies-section {
  margin-bottom: 16rpx;
}

.section-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.strategy-row {
  margin-bottom: 10rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card-muted);
  border: 1.5px solid var(--border);
  overflow: hidden;
  transition: border-color var(--transition);
}

.strategy-row.expanded {
  border-color: #2D2D2D;
}

.strategy-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.strategy-badge {
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  background: var(--accent-warm);
  border: 1px solid #2D2D2D;
  flex-shrink: 0;
}

.strategy-badge text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.strategy-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expand-arrow {
  font-size: 20rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.strategy-body {
  padding: 0 20rpx 20rpx;
}

.script-area {
  background: var(--bg-card);
  border: 1.5px dashed var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.script-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  display: block;
  padding-right: 80rpx;
}

.copy-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  overflow: hidden;
  padding: 8rpx 24rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  transform: translate(0, 0) rotate(0.3deg);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.copy-btn text {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.copy-btn:active {
  transform: translate(3px, 3px) rotate(0.3deg);
  box-shadow: none;
}

.meta-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.meta-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.meta-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.meta-value {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.6;
  flex: 1;
}

.risk-meta .meta-value {
  color: #C44E3D;
}

.strategy-note {
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--accent);
  background: var(--accent-ghost);
  border-radius: 0 8rpx 8rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8rpx;
}

.strategy-note .meta-icon {
  margin-top: 2rpx;
}

.note-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
}

.note-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  width: 100%;
}

.show-all-btn {
  text-align: center;
  padding: 12rpx 0;
  border-top: 1.5px dashed var(--border);
}

.show-all-btn text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}
