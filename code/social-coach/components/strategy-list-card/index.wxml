<wxs module="utils">
var truncate = function (script, maxLen) {
  if (!script) return '';
  maxLen = maxLen || 40;
  if (script.length <= maxLen) return script;
  return script.substring(0, maxLen) + '...';
};
module.exports = { truncate: truncate };
</wxs>

<view class="card-container">

  <!-- ===== 引导区 ===== -->
  <view class="guide-section">
    <view class="guide-header">
      <text class="context-badge">{{contextLabel}}</text>
      <text class="guide-title">{{guideTitle}}</text>
    </view>
    <text class="guide-intro">{{guideIntro}}</text>

    <!-- 快速参考表 -->
    <view class="quick-ref" wx:if="{{guideQuickRef.length > 0}}">
      <view
        wx:for="{{guideQuickRef}}"
        wx:key="label"
        class="ref-row"
        data-index="{{index}}"
        bindtap="onTapGuideRow"
      >
        <view class="ref-badge">
          <text>{{item.label}}</text>
        </view>
        <text class="ref-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="guide-tip" wx:if="{{guideTip}}">
      <text>{{guideTip}}</text>
    </view>
  </view>

  <!-- ===== 策略列表 ===== -->
  <view class="strategies-section">
    <view class="section-label-row">
      <image class="section-icon" src="/images/strategy-paths.svg" mode="aspectFit" />
      <text class="section-label">{{strategies.length}}条策略路径</text>
    </view>

    <view
      wx:for="{{strategies}}"
      wx:key="typeKey"
      class="strategy-row {{expandedIndex === index ? 'expanded' : ''}}"
    >
      <!-- 折叠态 -->
      <view
        class="strategy-header"
        data-index="{{index}}"
        bindtap="onToggleStrategy"
      >
        <view class="strategy-badge">
          <text>{{item.typeLabel}}</text>
        </view>
        <text class="strategy-preview">{{utils.truncate(item.script, 40)}}</text>
        <text class="expand-arrow">{{expandedIndex === index ? '▲' : '▼'}}</text>
      </view>

      <!-- 展开态 -->
      <view class="strategy-body" wx:if="{{expandedIndex === index}}">
        <view class="script-area">
          <text class="script-text">{{item.script}}</text>
          <view
            class="copy-btn"
            data-script="{{item.script}}"
            data-type-label="{{item.typeLabel}}"
            bindtap="onCopyScript"
          >
            <image class="btn-bg-img" src="/images/btn-small-bg.png" mode="aspectFill" />
            <text>复制</text>
          </view>
        </view>

        <view class="meta-list">
          <view class="meta-row">
            <image class="meta-icon" src="/images/strategy-rhythm.svg" mode="aspectFit" />
            <text class="meta-label">回复节奏：</text>
            <text class="meta-value">{{item.rhythm}}</text>
          </view>

          <view class="meta-row">
            <image class="meta-icon" src="/images/strategy-counter.svg" mode="aspectFit" />
            <text class="meta-label">对方可能反问：</text>
            <text class="meta-value">{{item.counterQuestion}}</text>
          </view>

          <view class="meta-row risk-meta">
            <image class="meta-icon" src="/images/strategy-risk.svg" mode="aspectFit" />
            <text class="meta-label">风险提示：</text>
            <text class="meta-value">{{item.risk}}</text>
          </view>
        </view>

        <view class="strategy-note" wx:if="{{item.strategicNote}}">
          <image class="meta-icon" src="/images/strategy-note.svg" mode="aspectFit" />
          <text class="note-label">战略标注</text>
          <text class="note-text">{{item.strategicNote}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="show-all-btn" wx:if="{{strategies.length > 3 && expandedIndex === -1}}" bindtap="onToggleShowAll">
    <text>{{showAll ? '收起策略' : '查看全部 ' + strategies.length + ' 条策略'}}</text>
  </view>

  <view class="bottom-fade"></view>
</view>
