/* ========== split-card 原子组件样式 ========== */

.card-container {
  position: relative;
  background: #fff;
  border-radius: 4px;
  margin: 0 16px;
  padding: 20px 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.card-title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16px;
  text-align: center;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 选项卡片 */
.option-item {
  display: flex;
  align-items: center;
  padding: 16px 12px;
  border-radius: 4px;
  border-left: 4px solid #e8e8e8;
  background: #fafafa;
}

/* urgent — 品牌红 */
.option-urgent {
  border-left-color: #e94560;
}

/* prepare — 深蓝 */
.option-prepare {
  border-left-color: #0f3460;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-label {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4px;
}

.option-desc {
  font-size: 12px;
  color: #888;
  line-height: 1.5;
}

.option-arrow {
  font-size: 17px;
  color: #ccc;
  margin-left: 8px;
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 24px;
  background: linear-gradient(transparent, #fff);
  pointer-events: none;
}

/* ========== 暗黑模式 ========== */
@media (prefers-color-scheme: dark) {
  .card-container {
    background: #2a2a2e;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .card-title {
    color: #e0e0e0;
  }

  .option-item {
    background: #333;
    border-left-color: #404040;
  }

  .option-urgent {
    border-left-color: #e94560;
  }

  .option-prepare {
    border-left-color: #5a8fd4;
  }

  .option-label {
    color: #e0e0e0;
  }

  .option-desc {
    color: #808080;
  }

  .option-arrow {
    color: #666;
  }

  .bottom-fade {
    background: linear-gradient(transparent, #2a2a2e);
  }
}
