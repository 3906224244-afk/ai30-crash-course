/* ===== split-card — 手绘选项卡 ===== */

.card-container {
  position: relative;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 24rpx 18rpx 28rpx 16rpx;
  margin: 0 16px;
  padding: 28rpx 24rpx;
  overflow: hidden;
  box-shadow: 3px 3px 0 #2D2D2D;
  transform: rotate(0.35deg);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  text-align: center;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--border);
  background: var(--bg-card-muted);
  box-shadow: var(--shadow-hard-sm);
  transform: translate(0, 0);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.option-item:active {
  transform: translate(2px, 2px);
  box-shadow: 0 0 0 #2D2D2D;
}

.option-urgent {
  border-color: #2D2D2D;
  border-left-width: 5rpx;
}

.option-prepare {
  border-color: #2D2D2D;
  border-left-width: 5rpx;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.option-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.option-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}
