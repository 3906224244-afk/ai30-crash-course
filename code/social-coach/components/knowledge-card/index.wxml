<view class="card-container" style="max-height: {{_maxHeight}}px;">
  <!-- 标题区 -->
  <view class="card-header">
    <text class="header-icon">📚</text>
    <text class="card-title">{{title}}</text>
  </view>

  <view class="card-divider"></view>

  <!-- 正文区 -->
  <view class="card-content">
    <text class="content-text">{{content}}</text>
  </view>

  <!-- 要点提示 -->
  <view class="tips-section" wx:if="{{tips.length > 0}}">
    <text class="tips-header">💡 要点</text>
    <view class="tips-list">
      <view class="tip-item" wx:for="{{tips}}" wx:key="*this">
        <text class="tip-dot">·</text>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 来源 + 确认按钮 -->
  <view class="card-footer">
    <text class="source-text">📌 来源：{{source}}</text>
    <view class="ack-btn" bindtap="onAcknowledge">
      <image class="btn-bg-img" src="/images/btn-small-bg.png" mode="aspectFill" />
      <text>知道了</text>
    </view>
  </view>

  <view class="bottom-fade"></view>
</view>
