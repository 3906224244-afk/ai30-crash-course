/* ===== knowledge-card — 手绘便签 ===== */

.card-container {
  position: relative;
  background: var(--bg-card);
  border: 1.5px solid #2D2D2D;
  border-radius: 20rpx 30rpx 14rpx 26rpx;
  margin: 0 16px;
  padding: 28rpx 24rpx;
  overflow: hidden;
  box-shadow: 3px 3px 0 #2D2D2D;
  transform: rotate(-0.3deg);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.card-divider {
  height: 1px;
  background: var(--border);
  margin-bottom: 16rpx;
}

.card-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  display: block;
  max-height: 216px;
  overflow: hidden;
}

.tips-section {
  background: var(--bg-card-muted);
  border: 1px solid var(--border);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.tips-header {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-dot {
  font-size: 28rpx;
  color: var(--accent);
  margin-right: 8rpx;
  line-height: 1.6;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.source-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.ack-btn {
  position: relative;
  overflow: hidden;
  padding: 8rpx 24rpx;
  background: transparent;
  border: none;
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
  box-shadow: none;
  transform: rotate(0.3deg);
}
.ack-btn:active {
  transform: translate(2px, 2px) rotate(0.3deg);
  box-shadow: none;
}

.bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 32rpx;
  background: linear-gradient(transparent, var(--bg-card));
  pointer-events: none;
}
