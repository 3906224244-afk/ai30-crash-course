/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: inline-block;
}
.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #fff;
  color: #e94560;
  border: 2rpx solid #e94560;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  text-align: center;
  display: inline-block;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 输入框 */
.input-area {
  width: 100%;
  min-height: 160rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.3s;
}
.input-area:focus {
  border-color: #e94560;
  background: #fff;
}
